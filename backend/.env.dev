# ── 开发环境配置 ──
APP_ENV=dev
APP_DEBUG=true

# ── 服务端口 ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── 存储路径 ──
STORAGE_QDRANT_PATH=./qdrant_db
STORAGE_SQLITE_PATH=./data/app.db
STORAGE_UPLOAD_DIR=./data/uploads

# ── 嵌入模型 ──
EMBEDDING_DENSE_MODEL=../local_model_cache/AI-ModelScope/bge-large-zh-v1___5
EMBEDDING_SPARSE_MODEL=Qdrant/bm25
EMBEDDING_DEVICE=cpu

# ── LLM (Ollama 本地) ──
LLM_OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_TEMPERATURE=0.0
LLM_NUM_CTX=4096

# ── RAG 参数 ──
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7
RAG_CHILD_CHUNK_SIZE=500
RAG_CHILD_CHUNK_OVERLAP=100
RAG_MAX_ITERATIONS=10
RAG_MAX_TOOL_CALLS=8

# ── 长期记忆 ──
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_TOP_K=5

# ── Langfuse 可观测 (选配) ──
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── 上传限制 ──
UPLOAD_MAX_SIZE_MB=50

# ── HuggingFace 镜像 (国内加速) ──
HF_ENDPOINT=https://hf-mirror.com
